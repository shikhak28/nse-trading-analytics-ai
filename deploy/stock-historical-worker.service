# Historical candle sync worker -- runs daily-eod-sync, instrument-master-
# refresh, and daily-movers-snapshot schedules (see historicalWorker.js).
# Without this running, no candle data ever syncs on this machine.
[Unit]
Description=Stock platform - historical sync worker
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/stock-platform/backend
ExecStart=/usr/bin/node historicalWorker.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
